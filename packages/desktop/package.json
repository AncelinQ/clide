{
  "name": "@clide/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "pnpm --filter @clide/web build && pnpm -w docs:build && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "package": "node build.mjs && electron-builder --win --config electron-builder.yml",
    "package:dir": "node build.mjs && electron-builder --win --dir --config electron-builder.yml"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@clide/core": "workspace:*",
    "@clide/server": "workspace:*",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "@clide/web": "workspace:*"
  },
  "description": "Poste de travail Windows pour piloter Claude Code",
  "author": "Ancelin Quinton"
}
